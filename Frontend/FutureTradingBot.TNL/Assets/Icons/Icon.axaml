<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Close Icon -->
    <StreamGeometry x:Key="CloseIcon">
        M 4,4 L 16,16 M 16,4 L 4,16
    </StreamGeometry>

    <!-- Maximize Icon -->
    <StreamGeometry x:Key="MaximizeIcon">
        M 2,2 L 14,2 14,14 2,14 Z
    </StreamGeometry>
</ResourceDictionary>
