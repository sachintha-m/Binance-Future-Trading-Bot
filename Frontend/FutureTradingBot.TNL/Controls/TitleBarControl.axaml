<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FutureTradingBot.TNL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FutureTradingBot.TNL.Controls.TitleBarControl"
             x:DataType="vm:MainViewModel">
    
    <Border Background="{StaticResource TitleBarBrush}" PointerPressed="TitleBar_PointerPressed"
            >
        <Grid ColumnDefinitions="*,Auto" Margin="10,0,6,0">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Image Source="/Assets/avalonia-logo.ico" Width="22" Height="22"/>
                <TextBlock Text="{Binding AppTitle}"
                           FontSize="14"
                           FontWeight="Light"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button Classes="MinimizeBtn"
                        Width="30"
                        Height="25"
                        Click="Minimize_Click"
                        Background="{StaticResource MinimizeBtnColor}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center">
                    <Rectangle Width="14"
                               Height="1.8"
                               Fill="Black"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="MaximizeBtn"
                        Width="30"
                        Height="25"
                        Click="Maximize_Click"
                        Background="{StaticResource MaximizeBtnColor}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center">
                    <Path Data="{StaticResource MaximizeIcon}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="Black"
                          StrokeThickness="1.9"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="CloseBtn"
                        Width="30"
                        Height="25"
                        Click="Close_Click"
                        Background="{StaticResource CloseBtnColor}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center">
                    <Path Data="{StaticResource CloseIcon}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="Black"
                          StrokeThickness="1.9"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    
</UserControl>
