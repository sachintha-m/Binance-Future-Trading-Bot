<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FutureTradingBot.TNL.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FutureTradingBot.TNL.Controls.TitleBarControl"
             x:DataType="vm:MainViewModel">
    
    <Border Background="Transparent" PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <Image Source="/Assets/avalonia-logo.ico" Width="20" Height="20"/>
                <TextBlock Text="{Binding AppTitle}"
                           FontSize="13"
                           FontWeight="Light"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button Width="46"
                        Height="36"
                        Click="Minimize_Click"
                        Background="Transparent">
                    <Rectangle Width="14"
                               Height="1.8"
                               Fill="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>
                <Button Width="46"
                        Height="36"
                        Click="Maximize_Click"
                        Background="Transparent">
                    <Path Data="{StaticResource MaximizeIcon}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="1.9"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
                <Button Width="46"
                        Height="36"
                        Click="Close_Click"
                        Background="Transparent">
                    <Path Data="{StaticResource CloseIcon}"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="1.9"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    
</UserControl>
