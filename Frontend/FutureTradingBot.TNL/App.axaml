<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FutureTradingBot.TNL.App"
             xmlns:local="using:FutureTradingBot.TNL"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FutureTradingBot.TNL/Styles/Styles.axaml"/>
    </Application.Styles>
             
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FutureTradingBot.TNL/Assets/Icons/Icon.axaml"/>
                <ResourceInclude Source="avares://FutureTradingBot.TNL/Styles/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BackgroundBrush">#000D30</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBrush">#1E293B</SolidColorBrush>
            <SolidColorBrush x:Key="AccentBrush">#2563EB</SolidColorBrush>
            <SolidColorBrush x:Key="TextBrush">#F8FAFC</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>